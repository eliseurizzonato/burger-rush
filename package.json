{
  "name": "burger-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo casual de lanchonete 3D",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "serve": "python3 -m http.server 8766 --bind 127.0.0.1 --directory www",
    "sync": "npm run vendor && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "bundle": "npm run sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "6.2.0",
    "@capacitor/android": "6.2.2",
    "@capacitor/cli": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@fontsource/fredoka": "5.3.0",
    "three": "0.128.0"
  }
}
